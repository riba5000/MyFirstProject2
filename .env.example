# Fonte de dados: "gfsearch" (default) | "serpapi" | "travelpayouts" | "amadeus"
FONTE=gfsearch

# Teto de buscas por rodada; 0 = sem teto. O gfsearch não tem cota, então 0.
# Se voltar ao SerpApi, use 6 (≈180/mês, dentro dos 250 gratuitos).
MAX_QUERIES_POR_RODADA=0
# true  = o preço devolvido é o total do grupo (padrão do Google Flights)
# false = o preço é por passageiro
PRECO_E_TOTAL=true

# SerpApi — só se FONTE=serpapi (chave em serpapi.com > Dashboard > Api Key)
SERPAPI_KEY=your_key_here
SERPAPI_QUOTA_MENSAL=250

# Travelpayouts / Aviasales Data API — só cache de 48h, NÃO serve para
# datas futuras. Mantido apenas para referência (ver AGENTS.md).
TRAVELPAYOUTS_TOKEN=your_token_here
TRAVELPAYOUTS_BASE_URL=https://api.travelpayouts.com

# Amadeus Self-Service — DESATIVADA pela Amadeus em 17/07/2026.
# Mantido só como histórico; não é mais possível obter chaves novas.
AMADEUS_BASE_URL=https://test.api.amadeus.com
AMADEUS_CLIENT_ID=your_client_id_here
AMADEUS_CLIENT_SECRET=your_client_secret_here

# SMTP (e.g. Gmail com App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@gmail.com
SMTP_PASSWORD=app_password_here
SMTP_FROM=seu@gmail.com
SMTP_TO=destino@email.com

# Fallback Playwright (desligado por padrão)
FALLBACK_ENABLED=false
